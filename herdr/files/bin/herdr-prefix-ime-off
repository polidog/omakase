#!/bin/bash
# Turn the fcitx5 IME off when the herdr prefix key (Ctrl+B) is pressed.
#
# Bound non-consuming in ~/.config/hypr/bindings.lua, so this runs on every
# Ctrl+B system-wide. Only act when the focused window is actually running
# herdr, otherwise Ctrl+B in editors, browsers, etc. would kill the IME too.

command -v fcitx5-remote >/dev/null || exit 0

pid=$(hyprctl activewindow -j 2>/dev/null | jq -r '.pid // empty')
[[ -n $pid && $pid -gt 0 ]] || exit 0

# Walk the focused window's process tree looking for the herdr client.
running_herdr() {
  local parent=$1 depth=$2 child
  ((depth > 8)) && return 1
  [[ $(cat "/proc/$parent/comm" 2>/dev/null) == herdr ]] && return 0
  for child in $(pgrep -P "$parent" 2>/dev/null); do
    running_herdr "$child" $((depth + 1)) && return 0
  done
  return 1
}

running_herdr "$pid" 0 || exit 0

# 2 = IME active (Japanese input on); nothing to do when it is already off.
[[ $(fcitx5-remote 2>/dev/null) == 2 ]] && fcitx5-remote -c
exit 0
